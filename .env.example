# Portal origin for enquiry ingest + Download our app QR / landing page
NEXT_PUBLIC_PORTAL_URL=https://1st-calluk-portal.vercel.app
PORTAL_ENQUIRY_URL=https://1st-calluk-portal.vercel.app/api/enquiries
PORTAL_ENQUIRY_SECRET=

# ---------------------------------------------------------------------------
# Blog → Facebook + Instagram syndication (Sanity webhook)
# LinkedIn is optional / deferred (set LINKEDIN_SYNDICATION_ENABLED=true later)
# ---------------------------------------------------------------------------
SOCIAL_SYNDICATION_ENABLED=true

# Shared secret for Sanity webhook HMAC (Manage → API → Webhooks → Secret)
SANITY_WEBHOOK_SECRET=

# Auth for manual syndicate + retry endpoints (Bearer token).
# Falls back to CRON_SECRET if unset.
SOCIAL_SYNDICATION_SECRET=
CRON_SECRET=

# Meta app (Karol Digital Posts) — needed to exchange short-lived → long-lived tokens
META_APP_ID=
META_APP_SECRET=
META_GRAPH_API_VERSION=v22.0

# --- Facebook Page: https://www.facebook.com/karolgraphics ---
FACEBOOK_SYNDICATION_ENABLED=true
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_ACCESS_TOKEN=

# --- Instagram: https://www.instagram.com/karoldigital2025/ ---
# Linked to the Facebook Page above. Page token works if it includes
# instagram_basic + instagram_content_publish.
INSTAGRAM_SYNDICATION_ENABLED=true
INSTAGRAM_BUSINESS_ACCOUNT_ID=
INSTAGRAM_ACCESS_TOKEN=

# --- LinkedIn (optional — off until app + ID verify are done) ---
LINKEDIN_SYNDICATION_ENABLED=false
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_PERSON_ID=
# LINKEDIN_AUTHOR_URN=urn:li:person:xxxxxxxx
LINKEDIN_API_VERSION=202503
